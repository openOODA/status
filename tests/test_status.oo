// # status Verification Suite
//
// Logline: Positive and negative-trust assertions over the QA seal that governs the status page.
//
// Setup: Pure functions over integers. No IO beyond the read capability.
//
// Beats:
//   1. Assert the seal round is deterministic and positive.
//   2. Assert a tampered nonce changes the seal.
//   3. Assert a forged digest fails closed.
//   4. Assert honest seals admit across an input sweep and reproduce bit-for-bit.
//   5. Assert the published page carries the VERSION stamp and full quota schema.
//   6. Assert the stamp matcher refuses prefix, extension, and absent versions.

import "std/core/primitives/str.oo";
import "std/fs/os/fs.oo";
import "qa/seal.oo";

fn expect(cond: Bool, label: String) -> Bool {
    if cond {
        println("ok " + label);
        return true;
    }
    println("FAIL " + label);
    return false;
}

// Exact version stamp: "v"+ver must appear with a non-version byte after it,
// so "0.3" can never satisfy a page stamped "v0.3.7".
fn stamp_ok(html: String, ver: String) -> Bool {
    if ver == "" { return false; }
    let needle: String = "v" + ver;
    let k: Int = str_index_of(html, needle);
    if k < 0 { return false; }
    let n: Int = chars_len(html);
    let e: Int = k + chars_len(needle);
    if e >= n { return true; }
    let c: String = char_at(html, e);
    return str_index_of("0123456789.", c) < 0;
}

// Count data-* schema attributes; -1 when any is malformed (missing
// =" or an empty/unterminated value). data-* name references inside
// <script> selectors are skipped; they are not attributes.
fn data_attrs_ok(html: String) -> Int {
    let mut rest: String = html;
    let mut dcount: Int = 0;
    let mut guard: Int = 0;
    while guard < 64 {
        let d: Int = str_index_of(rest, "data-");
        if d < 0 { break; }
        guard = guard + 1;
        let rn: Int = chars_len(rest);
        let mut ni: Int = d + 5;
        while ni < rn {
            let c: String = char_at(rest, ni);
            if str_index_of("abcdefghijklmnopqrstuvwxyz-", c) < 0 { break; }
            ni = ni + 1;
        }
        if ni + 1 < rn && char_at(rest, ni) == "=" && char_at(rest, ni + 1) == "\"" {
            dcount = dcount + 1;
            let v0: Int = ni + 2;
            let mut ve: Int = v0;
            while ve < rn && char_at(rest, ve) != "\"" { ve = ve + 1; }
            if ve == v0 || ve >= rn { return 0 - 1; }
            rest = str_slice(rest, ve + 1, rn);
        } else {
            rest = str_slice(rest, d + 5, rn);
        }
    }
    return dcount;
}

fn check_output(fs: &FsReadCap, p: Int) -> Int {
    // Output-schema completeness: every data-* attribute on the
    // published page must carry a non-empty quoted value, and the
    // seal must stay inside the positive 62-bit field.
    let hr: Result[String, String] = fs_read_file(fs, "index.html");
    let page: String = if hr.is_ok() { hr.val } else { "" };
    let dcount: Int = data_attrs_ok(page);
    if expect(dcount >= 8, "34 every data-* attribute carries a non-empty value") { p = p + 1; }
    let band: Bool = status_qa_seal(41, 7) >= 1 &&
        status_qa_seal(41, 7) <= 4611686018427387903 &&
        status_qa_seal(0 - 1, 0 - 1) <= 4611686018427387903;
    if expect(band, "35 seal output stays inside the positive 62-bit field") { p = p + 1; }
    return p;
}

fn check_page(fs: &FsReadCap, p: Int) -> Int {
    // Page-schema completeness: the published status page must carry
    // the VERSION stamp and every quota-card data attribute.
    let vr: Result[String, String] = fs_read_file(fs, "VERSION");
    let mut ver: String = "";
    if vr.is_ok() { ver = str_replace(vr.val, "\n", ""); }
    let hr: Result[String, String] = fs_read_file(fs, "index.html");
    let html: String = if hr.is_ok() { hr.val } else { "" };
    let readable: Bool = ver != "" && html != "";
    if expect(readable, "23 VERSION and index.html are readable") { p = p + 1; }
    let stamped: Bool = stamp_ok(html, ver);
    if expect(stamped, "24 page carries the VERSION stamp") { p = p + 1; }
    let core_attrs: Bool = str_index_of(html, "data-name") >= 0 &&
        str_index_of(html, "data-used-pct") >= 0 && str_index_of(html, "data-rem-pct") >= 0 &&
        str_index_of(html, "data-capacity") >= 0;
    if expect(core_attrs, "25 quota schema core attributes present") { p = p + 1; }
    let ext_attrs: Bool = str_index_of(html, "data-tps") >= 0 &&
        str_index_of(html, "data-accent-name") >= 0 && str_index_of(html, "data-reset-sec") >= 0 &&
        str_index_of(html, "data-sort") >= 0;
    if expect(ext_attrs, "26 quota schema extended attributes present") { p = p + 1; }
    return p;
}

pub fn main(
    fs_r: &FsReadCap,
    args: List[String]
) -> Result[Int, String] {
    let mut p: Int = 0;
    if expect(status_qa_agree(41, 7), "01 seal round is deterministic") { p = p + 1; }
    if expect(status_qa_admit(status_qa_seal(41, 7)), "02 seal stays in the positive field") { p = p + 1; }
    if expect(status_qa_seal(41, 7) != status_qa_seal(41, 8), "03 tampered nonce yields a different seal") { p = p + 1; }
    if expect(status_qa_forged(41, 0, 7), "04 forged digest yields a different seal") { p = p + 1; }
    if expect(!status_qa_admit(0), "05 zero seal is refused") { p = p + 1; }
    if expect(!status_qa_admit(0 - 1), "06 negative seal is refused") { p = p + 1; }
    if expect(status_qa_seal(0, 0) != status_qa_seal(41, 7), "07 empty-input seal differs") { p = p + 1; }
    if expect(status_qa_seal(41, 7) != status_qa_seal(0 - 1, 7), "08 forged negative digest differs") { p = p + 1; }
    if expect(status_qa_seal(41, 7) != status_qa_seal(41, 0 - 1), "09 forged negative nonce differs") { p = p + 1; }
    if expect(status_qa_seal(41, 7) != status_qa_seal(42, 7), "10 one-step digest drift differs") { p = p + 1; }
    if expect(status_qa_seal(100000007, 7) > 0, "11 large-input seal stays positive") { p = p + 1; }
    if expect(status_qa_admit(status_qa_seal(100000007, 7)), "12 large-input seal admitted") { p = p + 1; }
    if expect(status_qa_seal(41, 7) != status_qa_seal(7, 41), "13 swapped digest/nonce differs") { p = p + 1; }
    if expect(status_qa_seal(2147483647, 3) != status_qa_seal(3, 2147483647), "14 extreme swap differs") { p = p + 1; }
    if expect(status_qa_seal(1000000009, 11) == status_qa_seal(1000000009, 11), "15 prime input deterministic") { p = p + 1; }
    if expect(status_qa_admit(status_qa_seal(0 - 2147483647, 5)), "16 negative-large input seals positive") { p = p + 1; }
    let neg_seal: Int = status_qa_seal(0 - 2147483647, 5);
    if expect(neg_seal != status_qa_seal(41, 7), "17 negative-large differs from honest") { p = p + 1; }
    if expect(status_qa_seal(41, 0) != status_qa_seal(41, 7), "18 zero-nonce edge differs") { p = p + 1; }
    if expect(status_qa_seal(4294967291, 13) == status_qa_seal(4294967291, 13), "19 u32-max input deterministic") { p = p + 1; }
    if expect(status_qa_seal(9, 9) != status_qa_seal(9, 10), "20 self-bind nonce drift differs") { p = p + 1; }
    let admit_sweep: Bool = status_qa_admit(status_qa_seal(3, 11)) &&
        status_qa_admit(status_qa_seal(77, 5)) && status_qa_admit(status_qa_seal(1234, 99)) &&
        status_qa_admit(status_qa_seal(0 - 42, 7));
    if expect(admit_sweep, "21 honest seals admit across the input sweep") { p = p + 1; }
    let repro_sweep: Bool = status_qa_seal(3, 11) == status_qa_seal(3, 11) &&
        status_qa_seal(77, 5) == status_qa_seal(77, 5) &&
        status_qa_seal(1234, 99) == status_qa_seal(1234, 99);
    if expect(repro_sweep, "22 sweep seals reproduce bit-for-bit") { p = p + 1; }
    p = check_page(fs_r, p);
    if expect(status_qa_admit(1) && status_qa_admit(2), "27 admit floor accepts smallest positive seals") { p = p + 1; }
    let eq_seal: Int = status_qa_seal(2147483647, 2147483647);
    let eq_ok: Bool = eq_seal > 0 && status_qa_admit(eq_seal) && eq_seal != status_qa_seal(41, 7);
    if expect(eq_ok, "28 extreme-equal input seals positive and distinct") { p = p + 1; }
    if expect(stamp_ok("<b>>v0.3.7</b>", "0.3.7"), "29 stamp matcher accepts exact version") { p = p + 1; }
    let stamp_neg: Bool = !stamp_ok("<b>>v0.3.7</b>", "0.3") &&
        !stamp_ok("<b>>v0.3.7</b>", "0.3.7.1") &&
        !stamp_ok("<b>>v0.2.1</b>", "0.3.7") &&
        !stamp_ok("<b>no stamp</b>", "0.3.7");
    if expect(stamp_neg, "30 stamp matcher refuses prefix, extension, and absent versions") { p = p + 1; }
    if expect(stamp_ok("release v0.3.7", "0.3.7"), "31 stamp at end-of-string still matches") { p = p + 1; }
    let stamp_fuzz: Bool = !stamp_ok("v0.3.70", "0.3.7") &&
        !stamp_ok("v0.3.7.1", "0.3.7") &&
        stamp_ok("v0.3.7\nrest", "0.3.7") &&
        stamp_ok("v0.3.7-rc1", "0.3.7") &&
        !stamp_ok("<b>>v0.3.7</b>", "");
    if expect(stamp_fuzz, "32 stamp fuzz bounds zero/dot extensions, newline, prerelease, empty ver") { p = p + 1; }
    let neg_seal: Int = status_qa_seal(0 - 1, 7);
    let neg_ok: Bool = neg_seal != status_qa_seal(41, 7) &&
        status_qa_seal(41, 0 - 1) != status_qa_seal(41, 7) && neg_seal == status_qa_seal(0 - 1, 7);
    if expect(neg_ok, "33 negative seal inputs stay deterministic and distinct") { p = p + 1; }
    p = check_output(fs_r, p);
    if p == 35 {
        println("status tests: 35/35 passed");
        return Ok(0);
    }
    println("status tests: FAILED (" + to_string(p) + "/35)");
    return Ok(1);
}
